{
  "$defs": {
    "AssessmentPeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "AssessmentPeriod",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analytics_version": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Analytics Version",
      "type": "string"
    },
    "assessment_period": {
      "$ref": "#/$defs/AssessmentPeriod"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "execution_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Seconds"
    },
    "findings_generated": {
      "default": 0,
      "minimum": 0,
      "title": "Findings Generated",
      "type": "integer"
    },
    "records_analysed": {
      "default": 0,
      "minimum": 0,
      "title": "Records Analysed",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "software_version": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Software Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "dataset_id",
    "dataset_hash",
    "analytics_version",
    "software_version",
    "configuration",
    "configuration_hash",
    "assessment_period",
    "started_at",
    "status"
  ],
  "title": "AnalyticsRun",
  "type": "object"
}
