{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "ingestion_batch": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ingestion Batch",
          "type": "string"
        },
        "source_file": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "source_record": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Record",
          "type": "string"
        },
        "transformation_version": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Transformation Version",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "source_record",
        "ingestion_batch",
        "transformation_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "criticality": {
      "$ref": "#/$defs/Severity"
    },
    "cse_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Cse Id",
      "type": "string"
    },
    "environment": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "monitoring_expected": {
      "title": "Monitoring Expected",
      "type": "boolean"
    },
    "monitoring_source": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monitoring Source"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "system_type": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "System Type",
      "type": "string"
    }
  },
  "required": [
    "cse_id",
    "provenance",
    "asset_id",
    "criticality",
    "environment",
    "system_type",
    "monitoring_expected"
  ],
  "title": "Asset",
  "type": "object"
}
