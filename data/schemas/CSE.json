{
  "$defs": {
    "AssessmentPeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "AssessmentPeriod",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "ingestion_batch": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ingestion Batch",
          "type": "string"
        },
        "source_file": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "source_record": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Record",
          "type": "string"
        },
        "transformation_version": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Transformation Version",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "source_record",
        "ingestion_batch",
        "transformation_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_period": {
      "$ref": "#/$defs/AssessmentPeriod"
    },
    "criticality": {
      "$ref": "#/$defs/Severity"
    },
    "cse_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Cse Id",
      "type": "string"
    },
    "entity_size": {
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "title": "Entity Size",
      "type": "string"
    },
    "name": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "peer_group": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Peer Group",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sector": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Sector",
      "type": "string"
    }
  },
  "required": [
    "cse_id",
    "provenance",
    "name",
    "sector",
    "peer_group",
    "criticality",
    "assessment_period"
  ],
  "title": "CSE",
  "type": "object"
}
